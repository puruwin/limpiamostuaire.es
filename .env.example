# Entorno del sitio: production | provisional | staging | development.
# Solo "production" genera páginas indexables; cualquier otro valor (o ninguno) añade noindex.
# En CI lo decide el workflow (docs/despliegue.md).
SITE_ENV=development

# Clave pública del widget de Turnstile del formulario (M3.2). Vacía: la de pruebas de
# Cloudflare (siempre pasa). El build de producción falla sin ella. En CI: variable
# TURNSTILE_SITE_KEY del repo.
# PUBLIC_TURNSTILE_SITE_KEY=

# --- Endpoint del formulario (server/, npm run dev:api) ---
# En local todo tiene valor por defecto: claves de prueba de Turnstile, fotos en .data/fotos
# y, sin RESEND_API_KEY, los emails se escriben en la consola en vez de enviarse.
# En el VPS van en /etc/limpiamostuaire/api-<instancia>.env (docs/despliegue.md); con
# NODE_ENV=production el servicio no arranca si falta alguna.
# PORT=4311
# PUBLIC_URL=http://localhost:4321
# PHOTO_DIR=.data/fotos
# PHOTO_SIGNING_SECRET=        # openssl rand -base64 48
# TURNSTILE_SECRET_KEY=        # por defecto, la de pruebas (siempre pasa)
# RESEND_API_KEY=
# MAIL_FROM="Limpiamos tu aire <formulario@avisos.limpiamostuaire.es>"
# MAIL_TO=                     # varias, separadas por comas
# MAIL_SUBJECT_PREFIX=
