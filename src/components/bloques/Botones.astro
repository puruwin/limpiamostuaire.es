---
import Icon from "../Icon.astro";
import { business, telHref, whatsappHref } from "../../data/business";
import type { Locale } from "../../i18n/locales";
import { useTranslations } from "../../i18n/ui";

// WhatsApp (principal) y teléfono de una CTA. `translationKey`, la de la
// página, elige el saludo de WhatsApp. `tono` según el fondo de debajo.
interface Props {
  locale: Locale;
  translationKey: string;
  tono?: "claro" | "oscuro";
  class?: string;
}

const {
  locale,
  translationKey,
  tono = "claro",
  class: className,
} = Astro.props;
const t = useTranslations(locale);
const base =
  "inline-flex min-h-12 items-center justify-center gap-2 rounded-full px-6 font-semibold";
const estilos = {
  claro: {
    principal: "bg-tinta text-fondo hover:bg-acento-texto",
    secundario: "border-2 border-tinta hover:bg-suave",
  },
  oscuro: {
    principal: "bg-fondo text-tinta hover:bg-agua-clara",
    secundario:
      "border-2 border-fondo hover:border-agua-clara hover:text-agua-clara",
  },
}[tono];
---

<div class:list={["flex flex-col gap-3 sm:flex-row sm:flex-wrap", className]}>
  <a
    href={whatsappHref(locale, translationKey)}
    data-contacto="cta"
    class:list={[base, estilos.principal]}
  >
    <Icon name="whatsapp" />
    {t("cta.whatsapp")}
  </a>
  <a
    href={telHref()}
    data-contacto="cta"
    class:list={[base, estilos.secundario]}
  >
    <Icon name="phone" />
    {`${t("cta.call")} ${business.phone.display}`}
  </a>
</div>
