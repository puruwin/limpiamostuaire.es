---
import "../styles/global.css";
import { Font } from "astro:assets";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Seo from "../components/Seo.astro";
import WhatsAppFloat from "../components/WhatsAppFloat.astro";
import type { Locale } from "../i18n/locales";
import { useTranslations } from "../i18n/ui";
import { PUBLIC_UMAMI_WEBSITE_ID } from "astro:env/server";
import { isIndexable } from "../lib/site-env";
import { UMAMI_DOMAIN, UMAMI_SCRIPT } from "../lib/umami";

interface Props {
  lang: Locale;
  title: string;
  description: string;
  /** Para el menú (página actual), el selector de idioma y hreflang. */
  translationKey?: string | undefined;
  /** false para páginas sin URL propia, como la 404 (src/components/NotFound.astro). */
  canonical?: boolean;
  /**
   * noindex también en producción: páginas que no tienen que salir en Google,
   * como las de resultado del formulario (src/components/ResultadoPresupuesto.astro).
   */
  noindex?: boolean;
}

const {
  lang,
  title,
  description,
  translationKey,
  canonical,
  noindex = false,
} = Astro.props;
const t = useTranslations(lang);
const umamiWebsiteId = PUBLIC_UMAMI_WEBSITE_ID?.trim();
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {
      /* Solo SITE_ENV=production es indexable (docs/despliegue.md#indexación). */
      (!isIndexable || noindex) && (
        <meta name="robots" content="noindex, nofollow" />
      )
    }
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Font cssVariable="--font-figtree" preload />
    <Seo
      lang={lang}
      title={title}
      description={description}
      translationKey={translationKey}
      canonical={canonical}
    />
    <!-- Marca que hay JS, para plegar el menú móvil sin parpadeo. -->
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    {
      /*
        Umami (M3.3, src/lib/umami.ts): solo cuenta en limpiamostuaire.es
        (data-domains); staging y local cargan el script pero no envían nada.
      */
      umamiWebsiteId && (
        <script
          is:inline
          defer
          src={UMAMI_SCRIPT}
          data-website-id={umamiWebsiteId}
          data-domains={UMAMI_DOMAIN}
        />
      )
    }
  </head>
  <body class="flex min-h-screen flex-col bg-fondo font-sans text-tinta antialiased">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:z-50 focus:left-2 focus:rounded focus:bg-papel focus:px-4 focus:py-2"
    >
      {t("a11y.skipToContent")}
    </a>
    <Header locale={lang} translationKey={translationKey} />
    <main id="contenido" class="flex-1">
      <slot />
    </main>
    <Footer locale={lang} />
    <WhatsAppFloat locale={lang} translationKey={translationKey} />
  </body>
</html>
