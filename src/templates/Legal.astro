---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { useTranslations } from "../i18n/ui";
import { fechaLarga, fill } from "../lib/format";

// Páginas legales (M2.8): aviso legal, privacidad y cookies. H1, la fecha de
// `updated` y el cuerpo en una columna de lectura, sin bloques ni botones.
interface Props {
  page: CollectionEntry<"pages">;
}

const { page } = Astro.props;
const { locale, title, description, h1, translationKey, updated } = page.data;
const t = useTranslations(locale);
---

<BaseLayout
  lang={locale}
  title={title}
  description={description}
  translationKey={translationKey}
>
  <div class="mx-auto max-w-3xl px-4 pt-6 pb-16 sm:pt-10 lg:pt-16">
    <h1 class="text-3xl leading-tight font-bold sm:text-4xl">{h1}</h1>
    <p class="mt-4">
      {fill(t("legal.updated"), { date: fechaLarga(locale, updated) })}
    </p>
    <div class="prosa legal mt-8">
      <slot />
    </div>
  </div>
</BaseLayout>

<style>
  .legal :global(h2) {
    margin-top: 2.5rem;
    font-size: 1.5rem;
    line-height: 2rem;
    font-weight: 700;
  }

  .legal :global(h3) {
    margin-top: 1.75rem;
    font-size: 1.125rem;
    line-height: 1.75rem;
    font-weight: 700;
  }

  .legal :global(a) {
    overflow-wrap: anywhere;
  }

  /* Las tablas se desplazan en horizontal en el móvil, no la página. */
  .legal :global(table) {
    display: block;
    width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: 0.875rem;
  }

  .legal :global(th),
  .legal :global(td) {
    border: 1px solid color-mix(in srgb, var(--color-tinta) 15%, transparent);
    padding: 0.5rem 0.75rem;
    text-align: left;
    vertical-align: top;
  }

  .legal :global(th) {
    background: var(--color-suave);
    font-weight: 700;
  }

  .legal :global(td a) {
    color: var(--color-acento-texto);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
